generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Negocio {
  id        Int       @id @default(autoincrement())
  nome      String
  segmento  String
  alertaMin Int       @default(5)
  produtos  Produto[]
  usuarios  Usuario[]
  criadoEm  DateTime  @default(now())
}

model Produto {
  id          Int       @id @default(autoincrement())
  nome        String
  categoria   String
  marca       String?
  precoCusto  Float
  precoVenda  Float?
  negocio     Negocio   @relation(fields: [negocioId], references: [id])
  negocioId   Int
  variantes   Variante[]
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt
}

model Variante {
  id        Int     @id @default(autoincrement())
  quantidade  Int       @default(0)
  tamanho   String?
  cor       String?
  tecido    String?
  genero    String?
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId Int
  criadoEm  DateTime @default(now())
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nome      String
  email     String  @unique
  senha     String 
  role      String  @default("usuario")
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  negocioId Int
  criadoEm  DateTime @default(now())
}